# DeepSeek official API (platform.deepseek.com) — primary chat provider
DEEPSEEK_API_KEY=sk-xxxx

# OpenAI Agents SDK runtime
OPENAI_API_KEY=your-openai-api-key
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_AGENT_MAX_TURNS=6
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_ANALYSIS_MAX_TURNS=4

# AI cost reporting. Native model prices and billing currencies live in
# app/config/model_profiles.yaml; cross-currency conversion reads persisted
# exchange-rate snapshots and never blocks chat on a live FX provider.
FINANCE_REPORTING_CURRENCY=USD

# NewsAPI (https://newsapi.org - free tier available)
NEWS_API_KEY=your-news-api-key-here

# PostgreSQL (optional - falls back to in-memory if not set)
# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:18001,http://127.0.0.1:18001

# PostgreSQL (optional - falls back to in-memory if not set)
POSTGRES_DSN=postgresql://personal_finance_user:personal_finance_password@localhost:15433/personal_finance

# Read-only OpenBB market data. FinDesk currently allowlists YFinance only.
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_ALLOWED_PROVIDERS=yfinance
MARKET_DATA_TIMEOUT_SECONDS=12
MARKET_DATA_QUOTE_TTL_SECONDS=180
MARKET_DATA_HISTORY_TTL_SECONDS=86400
MARKET_DATA_PROFILE_TTL_SECONDS=604800
MARKET_DATA_SYMBOL_LIMIT=20
MARKET_DATA_HISTORY_DAY_LIMIT=3660
MARKET_DATA_OUTBOUND_CALL_BUDGET=3

# Official reference exchange rates via Frankfurter, pinned to the ECB dataset.
# Rates are immutable snapshots for reporting, not executable trading prices.
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_ALLOWED_PROVIDERS=frankfurter
EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev
EXCHANGE_RATE_TIMEOUT_SECONDS=10
EXCHANGE_RATE_MAX_SNAPSHOT_AGE_DAYS=7
