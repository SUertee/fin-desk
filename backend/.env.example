# DeepSeek official API (platform.deepseek.com) — primary chat provider
DEEPSEEK_API_KEY=sk-xxxx

# OpenAI Agents SDK runtime
OPENAI_API_KEY=your-openai-api-key
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_AGENT_MAX_TURNS=6
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_ANALYSIS_MAX_TURNS=4

# AI cost reporting. Native model prices and billing currencies live in
# app/config/model_profiles.yaml; cross-currency conversion reads persisted
# exchange-rate snapshots and never blocks chat on a live FX provider.
FINANCE_REPORTING_CURRENCY=USD

# NewsAPI (https://newsapi.org - free tier available)
NEWS_API_KEY=your-news-api-key-here

# PostgreSQL (optional - falls back to in-memory if not set)
# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:18001,http://127.0.0.1:18001

# PostgreSQL (optional - falls back to in-memory if not set)
POSTGRES_DSN=postgresql://personal_finance_user:personal_finance_password@localhost:15433/personal_finance
