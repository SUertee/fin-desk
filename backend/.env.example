# FinDesk 基础配置
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:18001,http://127.0.0.1:18001
POSTGRES_DSN=postgresql://personal_finance_user:personal_finance_password@localhost:15433/personal_finance

# 单用户登录。生产环境必须启用，并使用 `python -m app.auth.password` 生成哈希。
AUTH_ENABLED=false
AUTH_USER_ID=demo
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
# 自助初始化仅允许创建第一个 owner；初始化码只保存 SHA-256。
AUTH_ALLOW_INITIAL_REGISTRATION=false
AUTH_SETUP_TOKEN_HASH=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_ATTEMPT_LIMIT=8
AUTH_LOGIN_WINDOW_SECONDS=900

# Redis 仅作为可丢失缓存；PostgreSQL 仍是聊天记录与会话记忆的事实来源。
REDIS_URL=redis://localhost:16379/0
REDIS_KEY_PREFIX=findesk:v1
REDIS_CHAT_HISTORY_TTL_SECONDS=3600
REDIS_SESSION_MEMORY_TTL_SECONDS=86400
REDIS_SOCKET_TIMEOUT_SECONDS=1

# 主 LLM 配置
# 模型名称、价格和服务地址统一维护在 app/config/model_profiles.yaml，避免重复配置。
DEEPSEEK_API_KEY=

# 成本与投资报表配置
FINANCE_REPORTING_CURRENCY=USD
INVESTMENT_REPORTING_CURRENCY=CNY
INVESTMENT_QUOTE_STALE_AFTER_DAYS=3
INVESTMENT_CONCENTRATION_THRESHOLD_PERCENT=35

# 市场上下文开关
# 默认关闭；开启后仍然受运行时策略、来源白名单和外部调用预算约束。
MARKET_CONTEXT_ENABLED=false

# Tavily 受控联网搜索
TAVILY_API_KEY=
WEB_RESEARCH_PROVIDER=tavily
WEB_RESEARCH_ALLOWED_PROVIDERS=tavily
WEB_RESEARCH_BASE_URL=https://api.tavily.com
WEB_RESEARCH_ALLOWED_DOMAINS=bis.org,chinatax.gov.cn,csrc.gov.cn,ecb.europa.eu,federalreserve.gov,finra.org,gov.cn,imf.org,investor.gov,mof.gov.cn,oecd.org,pbc.gov.cn,worldbank.org
WEB_RESEARCH_TIMEOUT_SECONDS=10
WEB_RESEARCH_CACHE_TTL_SECONDS=3600
WEB_RESEARCH_MAX_RESULTS=5
WEB_RESEARCH_OUTBOUND_CALL_BUDGET=1

# 已审核理财知识检索
# 默认使用 lexical；配置硅基流动 Key 并显式切换为 hybrid 后才会调用 Embedding API。
KNOWLEDGE_RETRIEVAL_MODE=lexical
KNOWLEDGE_EMBEDDING_PROVIDER=siliconflow
KNOWLEDGE_EMBEDDING_ALLOWED_PROVIDERS=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSION=1024
SILICONFLOW_EMBEDDING_TIMEOUT_SECONDS=20
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_VECTOR_MIN_SCORE=0.45
KNOWLEDGE_RRF_K=60

# OpenBB 只读市场数据
# 当前仅允许 YFinance provider，不包含交易执行能力。
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_ALLOWED_PROVIDERS=yfinance
MARKET_DATA_TIMEOUT_SECONDS=12
MARKET_DATA_QUOTE_TTL_SECONDS=180
MARKET_DATA_HISTORY_TTL_SECONDS=86400
MARKET_DATA_PROFILE_TTL_SECONDS=604800
MARKET_DATA_SYMBOL_LIMIT=20
MARKET_DATA_HISTORY_DAY_LIMIT=3660
MARKET_DATA_OUTBOUND_CALL_BUDGET=4

# Vibe-Trading MCP 只读行情能力
# 默认关闭；本地验证使用 stdio，独立远程服务才使用 SSE，不会自动切换 transport。
MCP_VIBE_ENABLED=false
MCP_VIBE_TRANSPORT=stdio
MCP_VIBE_COMMAND=vibe-trading-mcp
MCP_STDIO_ALLOWED_COMMANDS=vibe-trading-mcp
MCP_VIBE_URL=http://127.0.0.1:8900/sse
MCP_SSE_ALLOWED_URLS=http://127.0.0.1:8900/sse
MCP_VIBE_ALLOWED_TOOLS=get_market_data
MCP_VIBE_TIMEOUT_SECONDS=20
MCP_VIBE_MAX_RESPONSE_BYTES=200000
MCP_VIBE_HEALTH_TTL_SECONDS=30
MCP_VIBE_MARKET_SOURCE=yfinance
MCP_VIBE_LOOKBACK_DAYS=90
MCP_VIBE_MAX_ROWS=90

# Frankfurter / ECB 参考汇率
# FinDesk 会持久化不可变汇率快照，聊天和报表不依赖实时外汇请求。
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_ALLOWED_PROVIDERS=frankfurter
EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev
EXCHANGE_RATE_TIMEOUT_SECONDS=10
EXCHANGE_RATE_MAX_SNAPSHOT_AGE_DAYS=7

# 财经收件箱（RSS / OPML，当前仅支持手动刷新）
FINANCE_INBOX_TIMEOUT_SECONDS=10
FINANCE_INBOX_MAX_RESPONSE_BYTES=2000000
FINANCE_INBOX_MAX_ENTRIES_PER_FEED=200
FINANCE_INBOX_MAX_REDIRECTS=3
FINANCE_INBOX_MAX_OPML_BYTES=1000000
FINANCE_INBOX_MAX_OPML_OUTLINES=200
# 仅当本机透明代理使用 198.18.0.0/15 Fake-IP DNS 时开启；生产环境保持关闭。
FINANCE_INBOX_ALLOW_PROXY_FAKE_IPS=false

# 账单自动接入
# 本机运行时使用相对路径；Docker Compose 会覆盖为 /data 下的挂载目录。
STATEMENT_INBOX_PATH=storage/import-inbox
STATEMENT_STORAGE_PATH=storage/statement-imports
STATEMENT_POLL_SECONDS=10
STATEMENT_STABLE_SECONDS=5
STATEMENT_MAX_FILE_BYTES=20000000

# 邮箱账单采用只读 IMAP。凭据只保存在 .env，不通过 Settings API 返回。
STATEMENT_EMAIL_POLL_SECONDS=300
STATEMENT_EMAIL_HOST=
STATEMENT_EMAIL_PORT=993
STATEMENT_EMAIL_USERNAME=
STATEMENT_EMAIL_PASSWORD=
STATEMENT_EMAIL_USE_SSL=true
